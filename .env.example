# Server
JUSTFASTLLM_HOST=0.0.0.0
JUSTFASTLLM_PORT=8000
JUSTFASTLLM_LOG_LEVEL=INFO
JUSTFASTLLM_DEFAULT_PROVIDER=openai
JUSTFASTLLM_CONFIG_FILE=

# Gateway behavior
JUSTFASTLLM_CACHE_ENABLED=true
JUSTFASTLLM_CACHE_BACKEND=redis
JUSTFASTLLM_CACHE_TTL_SECONDS=60
JUSTFASTLLM_CACHE_MAX_ITEMS=1024
JUSTFASTLLM_CACHE_PERSONAL_DATA_ALLOWED=false
# Remote database URLs used with compliance readiness must request encrypted transport.
# Postgres: ?sslmode=require | MySQL: ?ssl_mode=REQUIRED | MSSQL: ?encrypt=true | MongoDB: ?tls=true or mongodb+srv://...
JUSTFASTLLM_CACHE_DATABASE_URL=
JUSTFASTLLM_CACHE_DATABASE_TABLE=justfastllm_response_cache
JUSTFASTLLM_REDIS_KEY_PREFIX=justfastllm:cache:
JUSTFASTLLM_REQUEST_TIMEOUT_SECONDS=60
JUSTFASTLLM_MAX_BODY_BYTES=1048576
JUSTFASTLLM_MAX_MESSAGE_CHARS=200000
JUSTFASTLLM_CORS_ALLOW_ORIGIN=
JUSTFASTLLM_GUARDRAILS_ENABLED=true
# Disable specific checks with: required_messages,message_length,block_patterns
JUSTFASTLLM_DISABLED_GUARDRAILS=
JUSTFASTLLM_USER_MEMORY_ENABLED=true
JUSTFASTLLM_USER_MEMORY_BACKEND=redis
JUSTFASTLLM_USER_MEMORY_KEY_PREFIX=justfastllm:memory:
JUSTFASTLLM_USER_MEMORY_DATABASE_URL=
JUSTFASTLLM_USER_MEMORY_DATABASE_TABLE=justfastllm_user_memory
JUSTFASTLLM_POLICY_DENIED_MODELS=
JUSTFASTLLM_POLICY_ALLOWED_PROVIDERS=
JUSTFASTLLM_POLICY_REQUIRED_TAGS=
JUSTFASTLLM_POLICY_MAX_PROMPT_TOKENS=0
JUSTFASTLLM_POLICY_RESPONSE_BLOCK_PATTERNS=
JUSTFASTLLM_PLUGIN_MODULES=
REDIS_URL=redis://localhost:6379/0
JUSTFASTLLM_MASTER_KEY=
JUSTFASTLLM_KEY_HEADER_NAME=authorization
JUSTFASTLLM_CONTROL_PLANE_STORAGE_BACKEND=redis
JUSTFASTLLM_CONTROL_PLANE_STORAGE_PATH=
JUSTFASTLLM_CONTROL_PLANE_REDIS_URL=
JUSTFASTLLM_CONTROL_PLANE_REDIS_KEY=justfastllm:control-plane:state
JUSTFASTLLM_CONTROL_PLANE_DATABASE_URL=
JUSTFASTLLM_CONTROL_PLANE_DATABASE_TABLE=justfastllm_control_plane_state
JUSTFASTLLM_FALLBACK_PROVIDERS=
JUSTFASTLLM_MIRROR_PROVIDER=

# Privacy, retention, and compliance-readiness controls
JUSTFASTLLM_COMPLIANCE_MODE=true
JUSTFASTLLM_USAGE_RETENTION_DAYS=90
JUSTFASTLLM_AUDIT_RETENTION_DAYS=365
JUSTFASTLLM_PRIVACY_CONTACT=
JUSTFASTLLM_SECURITY_CONTACT=
JUSTFASTLLM_SUBPROCESSORS_URL=
JUSTFASTLLM_DPA_URL=
JUSTFASTLLM_REQUIRE_COMPLIANCE_READY=false

# Optional comma-separated regexes. Matching requests are rejected before API calls.
JUSTFASTLLM_BLOCK_PATTERNS=

# Provider API keys
OPENAI_API_KEY=
# Convenience alias used by benchmarks and OpenAI routing.
OPENAI_MODEL=gpt-5-nano
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
# Ollama does not require a key by default.
OLLAMA_API_KEY=

# Provider base URLs. Override when a provider changes endpoints or your account uses a regional endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
XAI_BASE_URL=https://api.x.ai/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
KIMI_BASE_URL=https://api.moonshot.ai/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Add any OpenAI-compatible provider without code changes.
# Provider names become uppercase env prefixes: local-ai -> LOCAL_AI_*.
JUSTFASTLLM_OPENAI_COMPATIBLE_PROVIDERS=
# Example:
# JUSTFASTLLM_OPENAI_COMPATIBLE_PROVIDERS=openrouter,local-ai
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL=openai/gpt-5-nano
# LOCAL_AI_REQUIRES_API_KEY=false
# LOCAL_AI_BASE_URL=http://localhost:8080/v1
# LOCAL_AI_DEFAULT_MODEL=tinyllama

# Optional provider defaults
OPENAI_DEFAULT_MODEL=gpt-5-nano
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
XAI_DEFAULT_MODEL=grok-4.7
QWEN_DEFAULT_MODEL=qwen-max
KIMI_DEFAULT_MODEL=kimi-k2.6
OLLAMA_DEFAULT_MODEL=llama3.1
